DATABASE_URL=postgresql://project_pilot:project_pilot@localhost:5432/project_pilot
# Replace this value before deploying. With NODE_ENV=production the backend
# refuses to start on this known placeholder; outside production it is
# accepted with a warning. The min 16 char length rule always applies.
SESSION_SECRET=change-me-to-something-secure
PORT=3001
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# Password sign-up is closed (there is no mail verification, so an open route
# lets anyone claim an address first). The only password account that can be
# created is the very first one, and only while this is "true" and the user
# table is empty. Uncomment for a first local run without GitHub sign-in, then
# remove it again; anything but "true" keeps registration closed.
# ALLOW_FIRST_PASSWORD_ACCOUNT=true
# Downstream service URLs. Optional outside production (they fall back to the
# public opentriologue.ai defaults with a warning), but REQUIRED with
# NODE_ENV=production: the backend refuses to start if any is unset or empty.
# Set them to instances you trust, especially before enabling GitHub sign-in.
# PROJECT_FORGE_URL=https://project-forge.opentriologue.ai
# AGENT_TASKS_URL=https://agent-tasks.opentriologue.ai
# DEPLOY_PANEL_URL=https://deploy-panel.opentriologue.ai
