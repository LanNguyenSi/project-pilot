generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // Users can now originate from two sources: local email/password registration
  // (passwordHash populated, email required) or GitHub OAuth (githubId populated,
  // passwordHash null, email optional since GitHub may hide it). Hence both
  // `email` and `passwordHash` are nullable; one of them is always set.
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  name         String?
  githubId     String?  @unique
  githubLogin  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys            ApiKey[]
  serviceCredentials ServiceCredential[]
  sessions           Session[]
  passwordResets     PasswordReset[]
  forgeTaskSnapshots ForgeTaskSnapshot[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  keyHash   String    @unique
  keyPrefix String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Captures the planforge task list from a project-forge `generate` preview so
// it survives the forge session (forge is stateless and deletes its temp dir
// after publish). Keyed by the forge sessionId; `repoUrl` is filled in at
// publish time with the normalized `owner/repo` (see repoKey()) so the Forge UI
// can later migrate the tasks into agent-tasks by repo, robustly across URL
// formatting differences. project-forge itself is never modified — pilot-local.
model ForgeTaskSnapshot {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  repoUrl   String?
  tasks     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId])
  @@index([userId, repoUrl])
}

model ServiceCredential {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   String   // "project-forge" | "agent-tasks" | "deploy-panel"
  token     String   // encrypted
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, service])
  @@index([userId])
}
